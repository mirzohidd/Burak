<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="admin-layout">
    <!-- Header -->

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="user-info">
          <img
            src="https://ui-avatars.com/api/?name=Admin&background=FD3B3B&color=fff"
            alt="Profile" />
          <div>
            <h4>Admin User</h4>
            <p>Administrator</p>
          </div>
        </div>
      </div>

      <nav class="sidebar-nav">
        <ul>
          <li>
            <a href="/admin/main">
              <i class="fas fa-tachometer-alt"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <li>
            <a href="/admin/product/all">
              <i class="fas fa-car"></i>
              <span>Cars</span>
            </a>
          </li>
          <li>
            <a href="/admin/user/all" class="active">
              <i class="fas fa-users"></i>
              <span>Users</span>
            </a>
          </li>
          <li>
            <a href="/admin/bookings">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>

          <li>
            <a
              href="/admin/logout"
              onclick="return confirm('Do you want to logout?')">
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout</span>
            </a>
          </li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content with-sidebar">
      <div class="page-header">
        <h1>Users Management</h1>
      </div>

      <form class="filter-bar">
        <div class="search-container">
          <i class="fas fa-search"></i>
          <input
            type="text"
            placeholder="Search users..."
            onchange="this.form.submit()" />
        </div>

        <div class="filters">
          <select class="filter-select" name="memberStatus" onchange="this.form.submit()">
            <option value="">All Status</option>
            <option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
            <option value="BLOCK"<%= status === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
            <option value="DELETE"<%= status === 'DELETE' ? 'selected' : '' %>>DELETE</option>
          </select>
        </div>
      </form>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Phone</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
            <tr>
              <td class="user-cell">
                <img
                  src="https://ui-avatars.com/api/?name=John+Doe&background=FD3B3B&color=fff"
                  alt="John Doe" />
                <span><%= user.memberNick %></span>
              </td>
              <td><%= user.memberPhone %></td>
             
              <td>
               
                
                  <select  id="<%= user._id%>" class="member-status <%= user.memberStatus.toLowerCase() %>" <%= user.memberStatus === "DELETE" ? "disabled" : "" %>>
                    <option value="ACTIVE" <%= user.memberStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                    <option value="BLOCK" <%= user.memberStatus === "BLOCK" ? "selected" : "" %>>BLOCK</option>
                    <option value="DELETE" <%= user.memberStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                  </select>
              </td>
              
              
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
        <a
          href="/admin/user/all?page=<%= i %>&status=<%= status || '' %>&search=<%= search || '' %>"
          class="pagination-btn <%= page === i ? 'active' : '' %>">
          <%= i %>
        </a>
        <% } %>
      </div>
      <% } %>
    </main>
  </div>
  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
