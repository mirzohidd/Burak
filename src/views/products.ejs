<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="user-info">
          <img
            src="https://ui-avatars.com/api/?name=Admin&background=FD3B3B&color=fff"
            alt="Profile" />
          <div>
            <h4>Admin User</h4>
            <p>Administrator</p>
          </div>
        </div>
      </div>

      <nav class="sidebar-nav">
        <ul>
          <li>
            <a href="/admin/">
              <i class="fas fa-tachometer-alt"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <li>
            <a href="/" class="active">
              <i class="fas fa-car"></i>
              <span>Cars</span>
            </a>
          </li>
          <li>
            <a href="/admin/user/all">
              <i class="fas fa-users"></i>
              <span>Users</span>
            </a>
          </li>
          <li>
            <a href="/admin//bookings">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>

          <li>
            <a
              href="/admin/logout"
              onclick="return confirm('Do you want to logout?')">
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout</span>
            </a>
          </li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content with-sidebar">
      <div class="page-header">
        <h1>Cars Management</h1>
        <button class="btn btn-primary add-car-toggler">
          <i class="fas fa-plus"></i> Add New Car
        </button>
      </div>

      <form  method="GET" action="/admin/product/all" class="filter-bar">
        <div class="search-container">
          <i class="fas fa-search"></i>
          <input
            type="text"
            name="search"
            placeholder="Search cars..."
            value="<%= search || '' %>"
            onchange="this.form.submit()"
          />
        </div>
      
        <div class="filters">
          <select class="filter-select" name="productType" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <option value="SEDAN" <%= type === 'SEDAN' ? 'selected' : '' %>>Sedan</option>
            <option value="SUV" <%= type === 'SUV' ? 'selected' : '' %>>SUV</option>
            <option value="HATCHBACK" <%= type === 'HATCHBACK' ? 'selected' : '' %>>Hatchback</option>
          </select>
      
          <select class="filter-select" name="productStatus" onchange="this.form.submit()">
            <option value="">All Status</option>
            <option value="PAUSE" <%= status === 'PAUSE' ? 'selected' : '' %>>Pause</option>
            <option value="AVAILABLE" <%= status === 'AVAILABLE' ? 'selected' : '' %>>Available</option>
            <option value="RENTED" <%= status === 'RENTED' ? 'selected' : '' %>>Rented</option>
            <option value="MAINTENANCE" <%= status === 'MAINTENANCE' ? 'selected' : '' %>>Maintenance</option>
            <option value="DELETE" <%= status === 'DELETE' ? 'selected' : '' %>>Delete</option>
         
          </select>
      
          
          
        </div>
      </form>
      
     
      
      <div class="cars-grid">
        <% products.forEach(product => { %>
          <div class="car-card">
            <div class="car-status">
              <%= product.productStatus %>
            </div>
      
            <div class="car-image">
              <img src="/<%= product.productImages?.[0] || '/placeholder.jpg' %>" alt="<%= product.productName %>" />
            </div>
      
            <div class="car-details">
              <h3><%= product.productName %></h3>
              <div class="car-meta">
                <span><i class="fas fa-calendar"></i> <%= product.productYear %></span>
                <span><i class="fas fa-gas-pump"></i> <%= product.productFuel %></span>
                <span><i class="fas fa-cog"></i> <%= product.productTransmission %></span>
              </div>
              <div class="car-price"><span class="price">$<%= product.productPrice %></span>/day</div>
            </div>
      
            <div class="car-actions">
              <a href="#" id="<%= product._id %>" class="btn btn-sm btn-outline button-update-modal">
                <i class="fas fa-edit"></i> Edit
              </a>
              
                <a href="#"  class="btn btn-sm btn-outline danger button-delete-modal" id="<%= product._id %>">
                  <i class="fas fa-trash"></i> Delete
                </a>
             
            </div>
          </div>
        <% }) %>
      </div>
      

     
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/product/all?page=<%= i %>&status=<%= status || '' %>&type=<%= type || '' %>&search=<%= search || '' %>"
               class="pagination-btn <%= page === i ? 'active' : '' %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      <% } %>
    </main>
  </div>
  <div class="modal" id="car-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">Add New Car</h3>
        <a href="#" class="modal-close add-car-toggler">&times;</a>
      </div>
      <div class="modal-body">
        <form
          id="car-form"
          onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          enctype="multipart/form-data">
          <input type="hidden" id="car-id" name="id" />

          <div class="form-row">
            <div class="form-group">
              <label for="car-name">Car Name</label>
              <input
                type="text"
                id="car-name"
                name="productName"
                class="product-name"
                required
                placeholder="e.g. Tesla Model 3" />
            </div>

            <div class="form-group">
              <label for="car-category">Category</label>
              <select id="car-category" name="productType" required>
                <option value="HATCHBACK">HATCHBACK</option>
                <option value="SEDAN">SEDAN</option>
                <option value="SUV">SUV</option>
              </select>
             
              
              
             
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="car-year">Year</label>
              <input
                type="number"
                id="car-year"
                name="productYear"
                required
                min="2000"
                max="2030"
                placeholder="e.g. 2023" />
            </div>

            <div class="form-group">
              <label for="car-fuel">Fuel Type</label>
              <select id="car-fuel" name="productFuel" required>
                <option value="PETROL">Petrol</option>
                <option value="DIESEL">Diesel</option>
                <option value="HYBRID">Hybrid</option>
               
                
              </select>
            </div>

            <div class="form-group">
              <label for="car-transmission">Transmission</label>
              <select id="car-transmission" name="productTransmission" required>
                
                <option value="AUTOMATIC">Automatic</option>
                <option value="MANUAL">Manual</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="car-price">Price per Day ($)</label>
              <input
                type="number"
                id="car-price"
                name="productPrice"
                required
                min="0"
                step="0.01"
                placeholder="e.g. 120.00" />
            </div>

            <div class="form-group">
              <label for="car-status-update">Product Status</label>
              <select
                id="car-status-update"
                name="productStatus"
                class="product-status"
                required
              >
                <option value="PAUSE">PAUSE</option>
                <option value="AVAILABLE">AVAILABLE</option>
                <option value="RENTED">RENTED</option>
                <option value="MAINTENANCE">MAINTENANCE</option>
                <option value="DELETE">DELETE</option>
              </select>
            </div>
            
            
            <input
              name="productStatus"
              value="PAUSE"
              class="product-status"
               />

            <div class="form-group">
              <label for="car-status">Product Model</label>
              <select id="car-status" name="productMarka" required>
                <option value="AUDI">AUDI</option>
                <option value="TOYOTA">Toyota</option>
                <option value="BMW">BMW</option>
                <option value="MERCEDENS">MERCEDENS-BENZ</option>
              </select>
            </div>
           
            
          </div>

          <div class="form-group">
            <label for="car-description">Description</label>
            <textarea
              id="car-description"
              name="description"
              rows="3"
              placeholder="Enter car description"></textarea>
          </div>

          <div class="form-group">
            <label for="car-image">Car Image</label>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="1" id="image-section-1" />
              <input
                type="file"
                id="car-image-1"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 1)"
                class="image-one" />
              <label for="car-image-1" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image
              </label>
              <span class="file-name">No file chosen</span>
            </div>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="2" id="image-section-2" />
              <input
                type="file"
                id="car-image-2"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 2)"
                class="image-two" />
              <label for="car-image-2" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image 2
              </label>
              <span class="file-name">No file chosen</span>
            </div>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="3" id="image-section-3" />
              <input
                type="file"
                id="car-image-3"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 3)"
                class="image-three" />
              <label for="car-image-3" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image 3
              </label>
              <span class="file-name">No file chosen</span>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" class="btn btn-outline" data-dismiss="modal">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">Save Car</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal update-modal" id="car-modal-update">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title-update">Update Car</h3>
        <a href="#" class="modal-close">&times;</a>
      </div>
      <div class="modal-body">
        <form
          id=""
          
          enctype="multipart/form-data"
        >
          <input type="hidden" id="car-id-update" name="id" />
  
          <div class="form-row">
            <div class="form-group">
              <label for="car-name-update">Car Name</label>
              <input
                type="text"
                id="car-name-update"
                name="productName"
                class="product-name"
                required
                placeholder="e.g. Tesla Model 3"
              />
            </div>
  
            <div class="form-group">
              <label for="car-category-update">Category</label>
              <select id="car-category-update" name="productType" required>
                <option value="HATCHBACK">HATCHBACK</option>
                <option value="SEDAN">SEDAN</option>
                <option value="SUV">SUV</option>
              </select>
            </div>
          </div>
  
          <div class="form-row">
            <div class="form-group">
              <label for="car-year-update">Year</label>
              <input
                type="number"
                id="car-year-update"
                name="productYear"
                required
                min="2000"
                max="2030"
                placeholder="e.g. 2023"
              />
            </div>
  
            <div class="form-group">
              <label for="car-fuel-update">Fuel Type</label>
              <select id="car-fuel-update" name="productFuel" required>
                <option value="PETROL">Petrol</option>
                <option value="DIESEL">Diesel</option>
                <option value="HYBRID">Hybrid</option>
              </select>
            </div>
  
            <div class="form-group">
              <label for="car-transmission-update">Transmission</label>
              <select id="car-transmission-update" name="productTransmission" required>
                <option value="AUTOMATIC">Automatic</option>
                <option value="MANUAL">Manual</option>
              </select>
            </div>
          </div>
  
          <div class="form-row">
            <div class="form-group">
              <label for="car-price-update">Price per Day ($)</label>
              <input
                type="number"
                id="car-price-update"
                name="productPrice"
                required
                min="0"
                step="0.01"
                placeholder="e.g. 120.00"
              />
            </div>
  
            <input
              name="productStatus"
              value="PAUSE"
              class="product-status"
              hidden
            />
  
            <div class="form-group">
              <label for="car-status-update">Product Model</label>
              <select id="car-status-update" name="productMarka" required>
                <option value="AUDI">AUDI</option>
                <option value="TOYOTA">Toyota</option>
                <option value="BMW">BMW</option>
                <option value="MERCEDENS">MERCEDENS-BENZ</option>
              </select>
            </div>
          </div>
  
          <div class="form-group">
            <label for="car-description-update">Description</label>
            <textarea
              id="car-description-update"
              name="description"
              rows="3"
              placeholder="Enter car description"
            ></textarea>
          </div>
  
          <div class="form-group">
            <label for="car-image-update">Car Image</label>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="1" id="image-section-1-update" />
              <input
                type="file"
                id="car-image-1-update"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 1)"
                class="image-one"
              />
              <label for="car-image-1-update" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image
              </label>
              <span class="file-name">No file chosen</span>
            </div>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="2" id="image-section-2-update" />
              <input
                type="file"
                id="car-image-2-update"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 2)"
                class="image-two"
              />
              <label for="car-image-2-update" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image 2
              </label>
              <span class="file-name">No file chosen</span>
            </div>
            <div class="file-input-container">
              <img src="/img/upload.svg" class="3" id="image-section-3-update" />
              <input
                type="file"
                id="car-image-3-update"
                name="productImages"
                accept="image/*"
                onchange="previewFileHandler(this, 3)"
                class="image-three"
              />
              <label for="car-image-3-update" class="file-input-label">
                <i class="fas fa-upload"></i> Choose Image 3
              </label>
              <span class="file-name">No file chosen</span>
            </div>
          </div>
  
          <div class="form-actions">
            <a href="#"  class="btn btn-outline" data-dismiss="modal">
              Cancel
            </a>
            <a href="#"  class="btn btn-primary save-update-car">Save Car</a>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
